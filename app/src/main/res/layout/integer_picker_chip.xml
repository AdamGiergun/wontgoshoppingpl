<?xml version="1.0" encoding="utf-8"?>
<!--
    Pojedynczy żeton wyboru liczby, tworzony w kodzie dla każdej wartości
    z zakresu preferencji. Osobny plik, bo styl Material trzeba podać przy
    konstruowaniu widoku — `Chip(context)` bez niego dostaje wygląd domyślny
    zamiast wariantu Filter.
-->
<com.google.android.material.chip.Chip
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Material3.Chip.Filter"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
