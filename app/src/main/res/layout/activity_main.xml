<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="eu.adamgiergun.wontgoshoppingpl.main.activity.MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/main_nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/adViewLayout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        AdView jest tworzony w kodzie (AdsContainer.start), bo baner adaptacyjny
        wymaga rozmiaru liczonego z szerokości okna, a AdView rozwijany z XML
        wymusza statyczny atrybut ads:adSize już przy inflacji.

        Szerokość ograniczona osobnym limitem, węższym niż treść: baner ciągnący
        się przez całą szerokość ekranu w poziomie wygląda jak pasek narzędzi,
        a nie jak reklama.
    -->
    <FrameLayout
        android:id="@+id/adViewLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="@dimen/ad_max_width" />

</androidx.constraintlayout.widget.ConstraintLayout>
