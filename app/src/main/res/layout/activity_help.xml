<?xml version="1.0" encoding="utf-8"?>
<!--
    Ekran pomocy.

    Wcześniej: NestedScrollView z marginesami 5dp (marginesy, nie wypełnienie,
    więc tekst kleił się do krawędzi po wyliczeniu insetów), akapity rozdzielone
    pięcioma pustymi TextView udającymi odstęp, wszystko pogrubione i bez
    przypisanej roli typograficznej, czyli w domyślnym rozmiarze widoku.

    Teraz: wypełnienie zamiast marginesów, odstęp z marginesu akapitu, rola
    BodyLarge i normalna grubość — pogrubiona zostaje tylko treść, która ma się
    wyróżniać, czyli odnośnik do polityki prywatności. Kolumna nie rozciąga się
    na tablecie poza szerokość czytelną dla oka.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="@dimen/help_padding_horizontal"
    android:paddingVertical="@dimen/help_padding_vertical"
    tools:context=".help.HelpActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/privacyPolicyLink"
            style="@style/HelpParagraph"
            android:layout_marginTop="0dp"
            android:text="@string/privacy_policy_link"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/helpTextView1"
            style="@style/HelpParagraph"
            android:text="@string/help_text_1" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/helpTextView2"
            style="@style/HelpParagraph"
            android:text="@string/help_text_2" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/helpTextView3"
            style="@style/HelpParagraph"
            android:text="@string/help_text_3" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/helpTextView4"
            style="@style/HelpParagraph"
            android:text="@string/help_text_4" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/helpTextView5"
            style="@style/HelpParagraph"
            android:text="@string/help_text_5" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
