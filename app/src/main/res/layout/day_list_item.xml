<?xml version="1.0" encoding="utf-8"?>
<!--
    Wiersz listy dni.

    Kolumny stały wcześniej na wagach LinearLayoutu 13/6/13, czyli na stałym
    podziale szerokości niezależnym od treści. Na wąskim ekranie „Whole day"
    łamało się na dwie linie, chociaż miejsce obok było puste, a na tablecie
    kolumny rozjeżdżały się na całą szerokość. Teraz data i godzina zajmują
    tyle, ile potrzebują, a nazwa dnia bierze resztę i to ona łamie się jako
    ostatnia.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    style="@style/DayCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_s"
    android:layout_marginVertical="@dimen/day_row_spacing">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/day_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical">

        <TextView
            android:id="@+id/date"
            style="@style/DayRowDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/spacing_xs"
            android:minWidth="@dimen/day_date_column_min"
            android:textAlignment="viewStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintEnd_toStartOf="@id/time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/time"
            style="@style/DayRowTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_s"
            android:textAlignment="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/name"
            app:layout_constraintStart_toEndOf="@id/date"
            app:layout_constraintTop_toTopOf="parent" />

        <!--
            Nazwa dnia jako jedyna dostaje 0dp, czyli resztę szerokości.
            To ona bywa najdłuższa („Wniebowzięcie Najświętszej Maryi Panny")
            i to ona ma się łamać, a nie „Whole day" obok pustego miejsca.
        -->
        <TextView
            android:id="@+id/name"
            style="@style/DayRowName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAlignment="viewEnd"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/time"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
