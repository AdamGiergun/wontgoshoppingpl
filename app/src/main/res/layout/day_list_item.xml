<?xml version="1.0" encoding="utf-8"?>
<!--
    Wiersz listy dni dla wąskich ekranów (poniżej 360dp) — wersja z nazwą dnia
    w osobnej linii. Wariant trzykolumnowy leży w layout-w360dp.

    Powód: przy 320dp i powiększonym rozmiarze wyświetlacza na kolumnę nazwy
    zostaje około 90dp, a „niehandlowa" potrzebuje 120dp. TextView łamie wtedy
    słowo w środku — „Niedziela n / iehandlowa" — co wygląda na błąd, a nie na
    zawijanie. Nazwa dostaje tu całą szerokość karty.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    style="@style/DayCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_s"
    android:layout_marginVertical="@dimen/day_row_spacing">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/day_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical">

        <TextView
            android:id="@+id/date"
            style="@style/DayRowDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/spacing_xs"
            android:textAlignment="viewStart"
            app:layout_constraintEnd_toStartOf="@id/time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/time"
            style="@style/DayRowTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:textAlignment="viewEnd"
            app:layout_constraintBottom_toBottomOf="@id/date"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/date" />

        <TextView
            android:id="@+id/name"
            style="@style/DayRowName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textAlignment="viewStart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/date" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
