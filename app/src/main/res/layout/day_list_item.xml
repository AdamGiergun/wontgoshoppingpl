<?xml version="1.0" encoding="utf-8"?>
<!--
    Wiersz listy dni. Struktura wag zostaje do Etapu 3, który zastąpi ją
    układem ConstraintLayout — tutaj zmienia się warstwa wizualna: karta
    Material 3 zamiast gołego CardView, kolory z ról motywu zamiast białego
    tekstu z cieniem, hierarchia typograficzna zamiast jednego rozmiaru.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_view"
    style="@style/DayCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_s"
    android:layout_marginVertical="@dimen/day_row_spacing">

    <LinearLayout
        android:id="@+id/LinearLayoutInCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/date"
            style="@style/DayRowDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="@dimen/date_field_weight"
            android:drawablePadding="@dimen/spacing_xs"
            android:textAlignment="textStart" />

        <TextView
            android:id="@+id/time"
            style="@style/DayRowTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="@dimen/time_field_weight"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/name"
            style="@style/DayRowName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="@dimen/name_field_weight"
            android:textAlignment="textEnd" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
