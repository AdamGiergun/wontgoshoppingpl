<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                             xmlns:app="http://schemas.android.com/apk/res-auto"
                                             android:layout_width="match_parent"
                                             android:layout_height="match_parent">


    <android.support.v7.widget.AppCompatTextView
        android:id="@+id/numberOfDaysBeforePrefix"
        style="@style/MyTextViewStyle"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="Remind me"
        app:layout_constraintBottom_toBottomOf="@+id/numberOfDaysBeforeView"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <android.support.v7.widget.AppCompatEditText
        android:id="@+id/numberOfDaysBeforeView"
        style="@style/MyEditTextStyle"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:inputType="time"
        android:text="1"
        app:layout_constraintLeft_toRightOf="@+id/numberOfDaysBeforePrefix"
        app:layout_constraintTop_toTopOf="parent"/>

    <android.support.v7.widget.AppCompatTextView
        android:id="@+id/numberOfDaysBeforeSuffix"
        style="@style/MyTextViewStyle"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="days before,"
        app:layout_constraintBottom_toBottomOf="@+id/numberOfDaysBeforeView"
        app:layout_constraintLeft_toRightOf="@+id/numberOfDaysBeforeView"
        app:layout_constraintTop_toTopOf="parent"/>

    <android.support.v7.widget.AppCompatTextView
        android:id="@+id/timeViewPrefix"
        style="@style/MyTextViewStyle"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="at"
        app:layout_constraintBottom_toBottomOf="@+id/timeView"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/numberOfDaysBeforePrefix"/>

    <android.support.v7.widget.AppCompatEditText
        android:id="@+id/timeView"
        style="@style/MyEditTextStyle"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:inputType="time"
        android:text="10:00"
        app:layout_constraintLeft_toRightOf="@+id/timeViewPrefix"
        app:layout_constraintTop_toBottomOf="@+id/numberOfDaysBeforePrefix"/>

    <android.support.v7.widget.AppCompatTextView
        android:id="@+id/timeViewSuffix"
        style="@style/MyTextViewStyle"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="."
        app:layout_constraintBottom_toBottomOf="@+id/timeView"
        app:layout_constraintLeft_toRightOf="@+id/timeView"
        app:layout_constraintTop_toBottomOf="@+id/numberOfDaysBeforePrefix"/>

</android.support.constraint.ConstraintLayout>