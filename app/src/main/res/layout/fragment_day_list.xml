<?xml version="1.0" encoding="utf-8"?>
<!--
    Lista dni. RecyclerView leży w ramce ograniczającej szerokość treści:
    na telefonie ograniczenie nie działa, bo ekran jest węższy, a na tablecie
    powstrzymuje wiersze przed rozciągnięciem na 2560 px, gdzie data i nazwa
    dnia oddalają się od siebie na tyle, że przestają się czytać jako jeden
    wiersz.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="eu.adamgiergun.wontgoshoppingpl.main.fragments.DaysFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width"
        tools:listitem="@layout/day_list_item" />

</androidx.constraintlayout.widget.ConstraintLayout>
