<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget: święto, zestaw 1, pigmenty.

    Sześć layoutów to trzy typy dnia razy dwa zestawy kolorystyczne. Podział jest
    konieczny, nie wygodny: RemoteViews rozwija launcher i rozwija je ponownie
    przy zmianie konfiguracji, więc kolor wyliczony w aplikacji i wysłany jako
    int rozjechałby się z tłem po przełączeniu trybu nocnego. Wszystko idzie
    przez zasoby, a stan wybiera layout.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_p1_holiday">

    <TextView
        android:id="@+id/appwidget_text"
        style="@style/AppWidgetText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:textColor="@color/p1_day_on_holiday_container" />

    <ImageView
        android:layout_width="@dimen/widget_icon_size"
        android:layout_height="@dimen/widget_icon_size"
        android:layout_gravity="top|start"
        android:layout_margin="@dimen/widget_icon_margin"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_cart_p1_holiday" />

</FrameLayout>
