<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.preference.SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="@string/include_holidays_preference_key"
        android:summaryOff="@string/summary_show_holidays_off"
        android:summaryOn="@string/summary_show_holidays_on"
        android:title="@string/title_show_holidays" />

    <androidx.preference.SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="@string/include_non_commerce_days_preference_key"
        android:summaryOff="@string/summary_show_non_commerce_days_off"
        android:summaryOn="@string/summary_show_non_commerce_days_on"
        android:title="@string/title_show_non_commerce_days" />

    <androidx.preference.SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="@string/include_commerce_sundays_preference_key"
        android:summaryOff="@string/summary_show_commerce_sundays_off"
        android:summaryOn="@string/summary_show_commerce_sundays_on"
        android:title="@string/title_show_commerce_sundays" />

    <androidx.preference.SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="@string/app_look_preference_key"
        android:summaryOff="@string/summary_app_look_mini"
        android:summaryOn="@string/summary_app_look_rich"
        android:title="@string/title_app_look" />

    <!-- A 'parent' preference, which enables/disables child preferences (below)
         when checked/unchecked. -->
    <androidx.preference.SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="@string/use_google_calendar_preference_key"
        android:summaryOff="@string/google_calendar_preference_summary_off"
        android:summaryOn="@string/google_calendar_preference_summary_on"
        android:title="@string/google_calendar_preference_title" />

    <!--
        <eu.adamgiergun.mylibrary.calendarmanagement.CalendarsListPreferenceNew
            android:dependency="@string/use_google_calendar_preference_key"
            android:key="@string/default_calendar_preference_key"
            android:title="@string/default_calendar_preference_title"/>
    -->
    <eu.adamgiergun.mylibrary.IntegerDialogPreference
        android:defaultValue="@integer/reminder_days_before_default_value"
        android:dependency="@string/use_google_calendar_preference_key"
        android:key="@string/default_reminder_days_before_preference_key"
        android:numeric="integer"
        android:title="@string/default_reminder_days_before_preference_title"
        app:defValue="@integer/reminder_days_before_default_value"
        app:maxValue="7"
        app:minValue="0" />

    <eu.adamgiergun.mylibrary.calendarmanagement.TimePreference
        android:defaultValue="@string/default_reminder_time_preference_default_value"
        android:dependency="@string/use_google_calendar_preference_key"
        android:key="@string/default_reminder_time_preference_key"
        android:title="@string/default_reminder_time_preference_title" />
</androidx.preference.PreferenceScreen>
