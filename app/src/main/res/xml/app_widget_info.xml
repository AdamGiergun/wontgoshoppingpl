<?xml version="1.0" encoding="utf-8"?>
<!--
    previewLayout pokazuje w wyborniku widżetów prawdziwy układ zamiast zrzutu
    ekranu; previewImage zostaje dla Androida 11 i starszych, które previewLayout
    nie znają.

    Wcześniej istniał drugi wariant tego pliku w xml-large — bez previewLayout
    i z innym minWidth, bez wyjaśnienia dlaczego. Na tablecie z Androidem 12+
    wygrywał kwalifikator, więc wybornik pokazywał tam zrzut zamiast układu.
    Skoro widget da się teraz skalować, o rozmiarze decyduje użytkownik i osobny
    wariant dla dużych ekranów nie ma czego rozstrzygać.

    targetCellWidth/Height to rozmiar początkowy w siatce launchera (Android 12+);
    starsze wersje biorą minWidth/minHeight.

    Rozmiar wyjściowy wynika z długości tekstu, a ta spadła: widget pokazuje typ
    dnia, nie nazwę własną święta, więc najdłuższym napisem jest „Niedziela
    niehandlowa" zamiast „dzień po Święcie Stulecia Niepodległości". Dwie kratki
    mieszczą to w dwóch wierszach z zapasem — sprawdzone na renderach po polsku,
    czyli w najdłuższym z dwunastu języków. minResize zostaje niżej, żeby dało się
    zejść jeszcze bardziej; skalowanie w ogóle było wcześniej niemożliwe
    (resizeMode="none").
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialKeyguardLayout="@layout/app_widget_p1_non_commerce"
    android:initialLayout="@layout/app_widget_p1_non_commerce"
    android:minWidth="150dp"
    android:minHeight="60dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/app_widget_preview"
    android:previewLayout="@layout/app_widget_p1_non_commerce"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="@integer/app_widget_update_period_millis"
    android:widgetCategory="home_screen" />
