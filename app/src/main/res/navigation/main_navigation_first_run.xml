<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_navigation"
    app:startDestination="@id/askForLook">

    <fragment
        android:id="@+id/askForLook"
        android:name="eu.adamgiergun.wontgoshoppingpl.main.AskForLook"
        android:label="AskForLook">
        <action
            android:id="@+id/action_askForLook_to_daysFragment"
            app:destination="@id/daysFragment"
            app:popUpTo="@id/askForLook"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/daysFragment"
        android:name="eu.adamgiergun.wontgoshoppingpl.main.DaysFragment"
        android:label="DaysFragment" />
</navigation>