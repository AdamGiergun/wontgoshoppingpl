<?xml version="1.0" encoding="utf-8"?>
<!--
    Tło okna dialogów preferencji. PreferenceDialogFragmentCompat buduje okno
    przez AlertDialog.Builder z appcompat, a nie przez MaterialAlertDialogBuilder,
    więc nie dostaje kształtu Material 3 z samego motywu — trzeba mu go podać
    jako windowBackground.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Kolor z ROLI MOTYWU, nie z zasobu: zestawy kolorystyczne podmieniają
         motyw, więc wskazanie konkretnego koloru przywiązałoby dialog do jednego
         z nich. Drawable rozwijany jest z kontekstem okna, więc ?attr działa. -->
    <solid android:color="?attr/colorSurface" />
    <corners android:radius="28dp" />
</shape>
