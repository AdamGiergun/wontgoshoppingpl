    <!-- ============ Paleta Material 3, wariant ciemny ============
         Katalog values-night istniał w projekcie od 2020 roku i był pusty —
         aplikacja nie miała trybu ciemnego w ogóle.

         Te same barwy co w wariancie jasnym (glina 34°, neutralne 55°), tylko
         role jasnościowe odwrócone. Uzasadnienie przeniesienia chromu do rodziny
         pigmentów — patrz values/colors.xml.

         Kontrasty: treść na powierzchni 13,3:1, treść wariantu 10,1:1,
         onPrimary na primary 7,7:1, obrys wobec tła 5,4:1. -->

    <color name="md_primary">#F6B8A2</color>
    <color name="md_on_primary">#5F1411</color>
    <color name="md_primary_container">#7B2D26</color>
    <color name="md_on_primary_container">#FDDBD0</color>

    <color name="md_secondary">#DBC1B4</color>
    <color name="md_on_secondary">#3F2C22</color>
    <color name="md_secondary_container">#564238</color>
    <color name="md_on_secondary_container">#F7DDD0</color>

