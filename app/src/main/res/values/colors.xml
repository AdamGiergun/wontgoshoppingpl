    <!-- ============ Paleta Material 3, wariant jasny ============
         Własna, nie dynamiczna. Sensem aplikacji jest odczytanie koloru dnia
         jednym spojrzeniem, a paleta pobrana z tapety użytkownika weszłaby
         w konflikt z kolorami niosącymi znaczenie. -->

    <color name="md_primary">#405AA9</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#DBE1FF</color>
    <color name="md_on_primary_container">#00174B</color>

    <color name="md_secondary">#585E71</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#DDE1F9</color>
    <color name="md_on_secondary_container">#151B2C</color>

    <color name="md_background">#FEFBFF</color>
    <color name="md_on_background">#1B1B1F</color>
    <color name="md_surface">#FEFBFF</color>
    <color name="md_on_surface">#1B1B1F</color>
    <color name="md_surface_variant">#E2E1EC</color>
    <color name="md_on_surface_variant">#45464F</color>
    <color name="md_outline">#767680</color>

    <color name="md_error">#BA1A1A</color>
    <color name="md_on_error">#FFFFFF</color>

    <!-- ============ Kolory znaczące dni ============
         Nasycone na tyle, żeby lista dawała się czytać rzutem oka, ale
         z kontrastem tekstu spełniającym wymogi dostępności — bez cienia
         pod literami, którym poprzednia wersja ratowała czytelność. -->

    <!-- Święta wyraźnie czerwone, nie łososiowe — inaczej z odległości ręki
         zlewają się z pomarańczem dni objętych zakazem handlu.
         Kontrast tekstu 7,5:1, czyli z zapasem ponad wymagane 4,5:1. -->
    <color name="day_holiday_container">#FF8A80</color>
    <color name="day_on_holiday_container">#410002</color>

    <color name="day_non_commerce_container">#FFC98F</color>
    <color name="day_on_non_commerce_container">#2B1700</color>

    <color name="day_commerce_container">#7EDC96</color>
    <color name="day_on_commerce_container">#00210E</color>


    <!-- Widget: RemoteViews nie widzi atrybutów motywu, kolory wprost -->
