<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Motyw aplikacji. Do tej pory bazą był Theme.AppCompat.Light.DarkActionBar
        z 2014 roku — zależność com.google.android.material była w projekcie, ale
        motyw z niej nie dziedziczył, więc MaterialCheckBox i FloatingActionButton
        w layoutach działały przez fallback i nie dostawały kolorów.

        DayNight sprawia, że tryb ciemny podąża za ustawieniem systemu; warianty
        kolorów mieszkają w values-night/colors.xml.

        Material 3 nie ma odpowiednika wariantu DarkActionBar — pasek tytułu
        bierze kolor z roli powierzchni, więc w trybie jasnym jest jasny.
    -->
    <!--
        Baza wspólna dla obu zestawów kolorystycznych. Nie ma tu ANI JEDNEGO
        koloru — wszystkie role siedzą w AppTheme.Pigmenty i AppTheme.Cukierki,
        żeby przełączenie zestawu było podmianą motywu, a nie mieszanką ról
        z dwóch palet.
    -->
    <style name="AppTheme.Base" parent="Theme.Material3.DayNight">
        <!-- Wariant Material 3 zamiast PreferenceThemeOverlay.v14.Material,
             który jest przestarzałym aliasem sprzed Material Design 2. -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>

        <!-- Dialogi preferencji budowane są przez appcompat, nie przez
             MaterialAlertDialogBuilder, więc bez tego zostają kanciaste i białe
             obok zaokrąglonych dialogów reszty aplikacji. -->
        <item name="alertDialogTheme">@style/PreferenceAlertDialog</item>

        <item name="actionBarStyle">@style/AppActionBar</item>
    </style>

    <!-- Zestaw 1: pigmenty — glina, ochra, mech. Motyw domyślny, wskazywany
         przez manifest; aktywności podmieniają go na Cukierki, gdy tak mówi
         preferencja. -->
    <style name="AppTheme.Pigmenty" parent="AppTheme.Base">
        <item name="colorPrimary">@color/p1_md_primary</item>
        <item name="colorOnPrimary">@color/p1_md_on_primary</item>
        <item name="colorPrimaryContainer">@color/p1_md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/p1_md_on_primary_container</item>

        <item name="colorSecondary">@color/p1_md_secondary</item>
        <item name="colorOnSecondary">@color/p1_md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/p1_md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/p1_md_on_secondary_container</item>

        <item name="android:colorBackground">@color/p1_md_background</item>
        <item name="colorOnBackground">@color/p1_md_on_background</item>
        <item name="colorSurface">@color/p1_md_surface</item>
        <item name="colorOnSurface">@color/p1_md_on_surface</item>
        <item name="colorSurfaceVariant">@color/p1_md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/p1_md_on_surface_variant</item>
        <item name="colorOutline">@color/p1_md_outline</item>

        <item name="colorError">@color/p1_md_error</item>
        <item name="colorOnError">@color/p1_md_on_error</item>
        <item name="colorErrorContainer">@color/p1_md_error_container</item>
        <item name="colorOnErrorContainer">@color/p1_md_on_error_container</item>

        <item name="colorTertiary">@color/p1_md_tertiary</item>
        <item name="colorOnTertiary">@color/p1_md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/p1_md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/p1_md_on_tertiary_container</item>

        <!--
            Role powierzchni wprowadzone w Material 3. Trzeba je nadpisać JAWNIE:
            bez tego biorą wartości z bazowej palety biblioteki, czyli z fioletu,
            i pasek górny nie pasuje do reszty, choćby colorPrimary był ciepły.
            To z nich, a nie z colorSurface, pasek bierze tło. Roli
            colorSurfaceTint tu nie ma, bo Material 1.14 jej nie zna.
        -->
        <item name="colorSurfaceContainerLowest">@color/p1_md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/p1_md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/p1_md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/p1_md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/p1_md_surface_container_highest</item>
        <item name="colorSurfaceDim">@color/p1_md_surface_dim</item>
        <item name="colorSurfaceBright">@color/p1_md_surface_bright</item>
        <item name="colorOutlineVariant">@color/p1_md_outline_variant</item>
        <item name="colorSurfaceInverse">@color/p1_md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/p1_md_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/p1_md_inverse_primary</item>
    </style>

    <!-- Zestaw 2: cukierki — wiśnia, bursztyn, szmaragd. -->
    <style name="AppTheme.Cukierki" parent="AppTheme.Base">
        <item name="colorPrimary">@color/p2_md_primary</item>
        <item name="colorOnPrimary">@color/p2_md_on_primary</item>
        <item name="colorPrimaryContainer">@color/p2_md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/p2_md_on_primary_container</item>

        <item name="colorSecondary">@color/p2_md_secondary</item>
        <item name="colorOnSecondary">@color/p2_md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/p2_md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/p2_md_on_secondary_container</item>

        <item name="android:colorBackground">@color/p2_md_background</item>
        <item name="colorOnBackground">@color/p2_md_on_background</item>
        <item name="colorSurface">@color/p2_md_surface</item>
        <item name="colorOnSurface">@color/p2_md_on_surface</item>
        <item name="colorSurfaceVariant">@color/p2_md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/p2_md_on_surface_variant</item>
        <item name="colorOutline">@color/p2_md_outline</item>

        <item name="colorError">@color/p2_md_error</item>
        <item name="colorOnError">@color/p2_md_on_error</item>
        <item name="colorErrorContainer">@color/p2_md_error_container</item>
        <item name="colorOnErrorContainer">@color/p2_md_on_error_container</item>

        <item name="colorTertiary">@color/p2_md_tertiary</item>
        <item name="colorOnTertiary">@color/p2_md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/p2_md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/p2_md_on_tertiary_container</item>

        <!--
            Role powierzchni wprowadzone w Material 3. Trzeba je nadpisać JAWNIE:
            bez tego biorą wartości z bazowej palety biblioteki, czyli z fioletu,
            i pasek górny nie pasuje do reszty, choćby colorPrimary był ciepły.
            To z nich, a nie z colorSurface, pasek bierze tło. Roli
            colorSurfaceTint tu nie ma, bo Material 1.14 jej nie zna.
        -->
        <item name="colorSurfaceContainerLowest">@color/p2_md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/p2_md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/p2_md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/p2_md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/p2_md_surface_container_highest</item>
        <item name="colorSurfaceDim">@color/p2_md_surface_dim</item>
        <item name="colorSurfaceBright">@color/p2_md_surface_bright</item>
        <item name="colorOutlineVariant">@color/p2_md_outline_variant</item>
        <item name="colorSurfaceInverse">@color/p2_md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/p2_md_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/p2_md_inverse_primary</item>
    </style>

    <!--
        Tytuł paska ma domyślnie 22sp (rola TitleLarge). Nazwa aplikacji jest
        długa: „Bez zakupów w PL" przy 360 dp i trzech akcjach obok nie mieści
        się i zostaje ucięta wielokropkiem. 20sp mieści ją w całości, a przy
        tłumaczeniach dłuższych od polskiego zostaje jeszcze zapas.
    -->
    <style name="AppActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="titleTextStyle">@style/AppActionBarTitle</item>
    </style>

    <style name="AppActionBarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="PreferenceAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <!-- Szerokość okna to szerokość treści, ale nie mniej niż te wartości.
             Domyślne (95% w pionie) rozdmuchiwały dialog z jednym pokrętłem na
             prawie cały ekran. Tytuł łamie się wtedy na dwie linie i tak ma być. -->
        <item name="android:windowMinWidthMinor">60%</item>
        <item name="android:windowMinWidthMajor">40%</item>
    </style>

</resources>
