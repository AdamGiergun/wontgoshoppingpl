<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Style widżetów. Motyw aplikacji przeniósł się do themes.xml — wcześniej
        wszystko mieszkało tutaj, a style widoków dziedziczyły po MOTYWIE
        (`parent="AppTheme"`), co działało przez przypadek: style i motywy dzielą
        przestrzeń nazw atrybutów, ale to nie jest ta sama rzecz.
    -->

    <!--
        Karta wyniesiona zamiast płaskiej. Material 3 wyraża głębię cieniem
        i tonem powierzchni, a nie fazowaną krawędzią — dawny wygląd „rich"
        z gradientami i obramowaniem 3D wyleciał w Etapie 2 właśnie dlatego,
        że taka fazka postarza interfejs bardziej niż cokolwiek innego.

        Tło nadaje kod (kolor typu dnia), więc wariant Elevated wnosi tu wyłącznie
        cień. W trybie ciemnym cień jest z natury ledwie widoczny i tak ma być:
        na ciemnym tle rolę odklejenia przejmuje jaśniejszy ton powierzchni.
    -->
    <style name="DayCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/day_card_corner</item>
        <item name="cardElevation">@dimen/day_card_elevation</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!--
        Skala typograficzna Material 3 zamiast dawnych
        ?attr/textAppearanceLargePopupMenu i ?attr/textAppearanceListItem,
        czyli krojów przeznaczonych dla menu podręcznego i pozycji listy
        systemowej. Hierarchia niesie teraz informację: nazwa dnia jest
        najważniejsza, data ją poprzedza, godzina jest etykietą.
    -->

    <style name="DayRowName" parent="TextAppearance.Material3.TitleMedium" />

    <style name="DayRowDate" parent="TextAppearance.Material3.BodyMedium" />

    <style name="DayRowTime" parent="TextAppearance.Material3.LabelMedium" />

    <!--
        Akapit pomocy. Szerokość ograniczona, bo wiersz dłuższy niż mniej więcej
        siedemdziesiąt znaków oko gubi przy przejściu do następnego — na telefonie
        limit nigdy nie działa, na tablecie zatrzymuje kolumnę tekstu.
        Odstęp między akapitami to margines górny, a nie puste widoki.
    -->
    <style name="HelpParagraph" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxWidth">@dimen/help_max_width</item>
        <item name="android:layout_marginTop">@dimen/help_paragraph_spacing</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="DialogLabel" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:layout_margin">@dimen/spacing_xs</item>
    </style>

    <style name="DialogEditableField" parent="DialogLabel">
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:background">?attr/colorSurfaceVariant</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:padding">@dimen/spacing_xs</item>
    </style>

    <!--
        Widget stoi na RemoteViews, więc nie widzi motywu aplikacji ani atrybutów
        typu ?attr/colorOnSurface — kolory muszą być podane wprost. Wariant ciemny
        siedzi w values-night/colors.xml.
    -->
    <style name="AppWidgetText">
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:shadowColor">@color/widget_text_shadow</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
        <item name="android:textSize">@dimen/appwidget_text_size</item>
    </style>

</resources>
