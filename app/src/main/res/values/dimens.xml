<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Skala odstępów. Wcześniej dimens.xml zawierał głównie wagi layoutu
         i jeden text_margin, więc każdy margines w każdym layoucie był
         ustalany osobno i niespójnie. Kolejne stopnie (16, 24 dp) dojdą,
         kiedy będzie ich użytkownik — lint słusznie zgłasza martwe zasoby. -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_s">8dp</dimen>

    <!-- Wiersz listy dni -->
    <dimen name="day_card_corner">12dp</dimen>
    <!-- Cień musi zmieścić się w marginesie karty, inaczej lista go przycina. -->
    <dimen name="day_card_elevation">3dp</dimen>
    <dimen name="day_row_padding_horizontal">12dp</dimen>
    <dimen name="day_row_padding_vertical">14dp</dimen>
    <dimen name="day_row_padding_vertical_compact">6dp</dimen>
    <dimen name="day_row_spacing">6dp</dimen>

    <!--
        Rozmiary tekstu wiersza. Style DayRow* nadal biorą z Material 3 krój,
        grubość i światło międzyliterowe — stąd nadpisujemy sam rozmiar.

        Dwie osie, obie realne:

        * szerokość ekranu. Te wartości to wariant wąski, poniżej 360 dp.
          Taki ekran nie musi być mały: telefon 1080x1920 przy natywnej
          gęstości 480 ma 360 dp, ale z ustawieniem „Rozmiar wyświetlacza"
          na maksa gęstość rośnie do 540 i zostaje 320 dp. Skala z wariantu
          w360dp zjada wtedy wiersz.
        * preferencja gęstości listy. Zwarta schodzi o stopień niżej, więc
          steruje nie tylko wysokością wiersza, ale i tym, ile tekstu wejdzie
          na ekran — to jest ta kontrola, o którą użytkownikowi chodzi.

        Jednostką jest sp, bo rozmiar czcionki to osobne ustawienie systemowe
        i ma działać. Od Androida 14 skalowanie jest nieliniowe: duży tekst
        rośnie wolniej niż mały, właśnie po to, żeby nagłówki nie eksplodowały.
    -->
    <dimen name="day_text_name">14sp</dimen>
    <dimen name="day_text_date">12sp</dimen>
    <dimen name="day_text_time">11sp</dimen>
    <dimen name="day_text_name_compact">13sp</dimen>
    <dimen name="day_text_date_compact">11sp</dimen>
    <dimen name="day_text_time_compact">10sp</dimen>

    <!-- Kolumna daty rośnie z treścią, ale nie schodzi poniżej tej szerokości.
         Bez tego godzina przeskakiwała w bok o kilka pikseli między wierszami,
         zależnie od tego, czy dzień miesiąca ma jedną cyfrę czy dwie. -->
    <dimen name="day_date_column_min">112dp</dimen>

    <!-- Przy wężu wysokość wiersza wynika z podziału wysokości listy, a nie
         z treści. Te wartości mówią, poniżej czego wiersz nie ma sensu — liczba
         wierszy to wysokość listy podzielona przez nie. -->
    <dimen name="day_row_min_height">68dp</dimen>
    <dimen name="day_row_min_height_compact">56dp</dimen>

    <!-- Baner ma własny limit, węższy niż treść. Rozciągnięty na całą szerokość
         ekranu w poziomie przestaje wyglądać jak reklama, a zaczyna jak pasek
         systemowy — i to on, a nie lista, rzuca się w oczy jako pierwszy. -->
    <dimen name="ad_max_width">480dp</dimen>

    <!-- Maksymalna szerokość treści. Powyżej niej wiersz przestaje rosnąć
         i zostaje wyśrodkowany; na telefonie ograniczenie nigdy nie działa. -->
    <dimen name="content_max_width">720dp</dimen>

    <!-- Ekran pomocy. Poprzednio 5dp marginesu na NestedScrollView, przez co
         tekst kleił się do krawędzi ekranu. -->
    <dimen name="help_padding_horizontal">16dp</dimen>
    <dimen name="help_padding_vertical">12dp</dimen>
    <dimen name="help_paragraph_spacing">16dp</dimen>
    <dimen name="help_max_width">640dp</dimen>

    <dimen name="reminder_view_padding">16dp</dimen>
    <dimen name="reminder_dialog_spacing">12dp</dimen>

    <!-- widget_margin (0dp) odpadł razem ze starym układem: kafelek wypełnia
         gniazdo, a odstęp od treści daje widget_padding. -->
    <dimen name="appwidget_text_size">12sp</dimen>
    <dimen name="widget_padding">10dp</dimen>
    <!-- 22dp to najmniejszy rozmiar, przy którym przekreślenie wózka czyta się
         jako osobny gest, a nie jako zamazanie rysunku. Przy 18dp ginęło,
         przy 26dp przerwa pod ukośnikiem robi się tak szeroka, że wózek wygląda
         na rozcięty. Sprawdzone na trzech renderach. -->
    <dimen name="widget_icon_size">22dp</dimen>
    <dimen name="widget_icon_margin">8dp</dimen>
    <!-- Od Androida 12 launcher zna wartość, którą sam stosuje do obrysu i cienia
         widgetu — użycie jej sprawia, że nasze tło pokrywa się z jego kształtem
         zamiast wystawać rogami. Niżej takiej stałej nie ma, więc 16dp na sztywno.
         Wariant v31 leży w values-v31/dimens.xml. -->
    <dimen name="widget_corner_radius">16dp</dimen>

</resources>
