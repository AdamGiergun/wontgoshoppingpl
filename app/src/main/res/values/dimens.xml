<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Skala odstępów. Wcześniej dimens.xml zawierał głównie wagi layoutu
         i jeden text_margin, więc każdy margines w każdym layoucie był
         ustalany osobno i niespójnie. -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_s">8dp</dimen>
    <dimen name="spacing_m">16dp</dimen>
    <dimen name="spacing_l">24dp</dimen>

    <!-- Wiersz listy dni -->
    <dimen name="day_card_corner">12dp</dimen>
    <dimen name="day_row_padding_horizontal">12dp</dimen>
    <dimen name="day_row_padding_vertical">14dp</dimen>
    <dimen name="day_row_padding_vertical_compact">6dp</dimen>
    <dimen name="day_row_spacing">6dp</dimen>

    <!-- Wagi kolumn wiersza. Etap 3 zastąpi je układem ConstraintLayout —
         na razie zostają, bo day_list_item.xml wciąż jest LinearLayoutem. -->
    <dimen name="date_field_weight">13</dimen>
    <dimen name="time_field_weight">6</dimen>
    <dimen name="name_field_weight">13</dimen>

    <dimen name="reminder_view_padding">16dp</dimen>
    <dimen name="reminder_dialog_spacing">12dp</dimen>

    <dimen name="widget_margin">0dp</dimen>
    <dimen name="appwidget_text_size">12sp</dimen>

</resources>
