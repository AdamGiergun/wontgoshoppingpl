<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Skala odstępów. Wcześniej dimens.xml zawierał głównie wagi layoutu
         i jeden text_margin, więc każdy margines w każdym layoucie był
         ustalany osobno i niespójnie. Kolejne stopnie (16, 24 dp) dojdą,
         kiedy będzie ich użytkownik — lint słusznie zgłasza martwe zasoby. -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_s">8dp</dimen>

    <!-- Wiersz listy dni -->
    <dimen name="day_card_corner">12dp</dimen>
    <dimen name="day_row_padding_horizontal">12dp</dimen>
    <dimen name="day_row_padding_vertical">14dp</dimen>
    <dimen name="day_row_padding_vertical_compact">6dp</dimen>
    <dimen name="day_row_spacing">6dp</dimen>

    <!-- Kolumna daty rośnie z treścią, ale nie schodzi poniżej tej szerokości.
         Bez tego godzina przeskakiwała w bok o kilka pikseli między wierszami,
         zależnie od tego, czy dzień miesiąca ma jedną cyfrę czy dwie. -->
    <dimen name="day_date_column_min">112dp</dimen>

    <!-- Baner ma własny limit, węższy niż treść. Rozciągnięty na całą szerokość
         ekranu w poziomie przestaje wyglądać jak reklama, a zaczyna jak pasek
         systemowy — i to on, a nie lista, rzuca się w oczy jako pierwszy. -->
    <dimen name="ad_max_width">480dp</dimen>

    <!-- Maksymalna szerokość treści. Powyżej niej wiersz przestaje rosnąć
         i zostaje wyśrodkowany; na telefonie ograniczenie nigdy nie działa. -->
    <dimen name="content_max_width">720dp</dimen>

    <dimen name="reminder_view_padding">16dp</dimen>
    <dimen name="reminder_dialog_spacing">12dp</dimen>

    <dimen name="widget_margin">0dp</dimen>
    <dimen name="appwidget_text_size">12sp</dimen>

</resources>
